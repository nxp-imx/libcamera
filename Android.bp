// ipa_nxp_neo.so
cc_library_shared {
    name: "ipa_nxp_neo",
    rtti: true,
    proprietary: true,
    relative_install_path: "ipa",
    srcs: [
        "src/ipa/nxp/neo/*.cpp",
        "src/ipa/nxp/neo/algorithms/*.cpp",
    ],
    generated_headers: [
        "ipa_nxp_neo_version_h",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-DLIBCAMERA_BASE_PRIVATE",
        "-DHAVE_LOCALE_T=1",
    ],

    static_libs: [
        "libipa",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libutils",
        "liblog",
        "libcamera",
        "libcamera-base",
        "libnxp_ipa_cam_helper",
    ],
    include_dirs: [
        "system/core/libcutils/include",
    ],
    local_include_dirs: [
        "include",
        "prebuilt-android/include",
        "src/ipa",
        "src/ipa/nxp/neo",
        "src/ipa/nxp/neo/algorithms",
        "src/ipa/rpi/controller",
    ],
}

// ipa_nxp_neo.so.sign
genrule {
    name: "ipa_nxp_neo_sign",
    tool_files: ["src/ipa/ipa-sign.sh"],
    srcs: [":libcamera_gen_ipa_priv_key",],
    device_first_srcs: [
        ":ipa_nxp_neo",
    ],
    out: ["ipa_nxp_neo.so.sign"],
    cmd: "$(location src/ipa/ipa-sign.sh) $(in) $(out)",
}

prebuilt_etc
{
    name: "libcamera_ipa_sign",
    sub_dir: "ipa",
    srcs: [
        ":ipa_nxp_neo_sign",
    ],
    vendor: true,
}

