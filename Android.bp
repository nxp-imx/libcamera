// NXP neo pipeline and NXP IPA configuration files
prebuilt_etc {
    name: "libcamera_yaml",
    sub_dir: "configs/libcamera/nxp/neo",
    srcs: [
        "src/libcamera/pipeline/nxp/neo/data/config.yaml",
        "src/ipa/nxp/neo/data/os08a20.yaml",
        "src/ipa/nxp/neo/data/mx95mbcam.yaml",
        ":libcamera_HDR",
    ],
    vendor: true,
}
