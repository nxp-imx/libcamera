genrule {
    name: "libcamera_gen_ipa_priv_key",
    tool_files: ["utils/gen-ipa-priv-key.sh"],
    out: ["tmp-private-key.pem"],
    cmd: "$(location utils/gen-ipa-priv-key.sh) $(out)",
}

genrule {
    name: "libcamera_gen_ipa_pub_key",
    tool_files: ["utils/codegen/gen-ipa-pub-key.py"],
    srcs: [
        ":libcamera_gen_ipa_priv_key",
        "src/libcamera/ipa_pub_key.cpp.in",
    ],
    out: ["ipa_pub_key.cpp"],

    cmd: "$(location utils/codegen/gen-ipa-pub-key.py) $(in) $(out)",
}

genrule {
    name: "libcamera_HDR",
    srcs: ["src/libcamera/pipeline/nxp/neo/data/config.yaml"],
    out: ["config_HDR.yaml"],
    cmd: "sed -e '/^%YAML/,/^\\.\\.\\./ { " +
        "s/^#\\s\\+streams:/    streams:/ " +
        "/^#\\s\\+Uncomment/d " +
        "}' $(in) > $(out)"
}

filegroup {
    name: "libcamera_sources",
    srcs: [
        ".git/**/*",
        ".gitignore",
        ".editorconfig",
        ".b4-config",
        ".clang*",
        ".reuse/*",
        ".sourcegraph/*",
        "subprojects/.gitignore",
        "**/*",
        "**/.style*",
    ],
}

genrule {
    name: "libcamera_gen_version_cpp",
    tool_files: [
        ":libcamera_sources",
        "utils/gen-version.sh",
    ],
    srcs: [ "src/libcamera/version.cpp.in", ],
    out: ["version.cpp"],
    cmd: "SBROOT=$$(realpath .) && " +
        "cd $$(dirname $$(dirname $(location utils/gen-version.sh))) && " +
        "GITVERSION=$$(./utils/gen-version.sh | awk '{print $$1}') && " +
        "cd $$SBROOT && " +
        "sed \"s~@VCS_TAG@~$$GITVERSION~g\" $(in) > $(out)"
}

genrule {
    name: "ipa_nxp_neo_version_h",
    tool_files: [
        ":libcamera_sources",
        "utils/gen-version.sh",
    ],
    srcs: [ "src/ipa/nxp/neo/neo_ipa_version.h.in", ],
    out: ["neo_ipa_version.h"],
    cmd: "SBROOT=$$(realpath .) && " +
        "cd $$(dirname $$(dirname $(location utils/gen-version.sh))) && " +
        "GITVERSION=$$(./utils/gen-version.sh | awk '{print $$1}') && " +
        "cd $$SBROOT && " +
        "sed \"s~@VCS_TAG@~$$GITVERSION~g\" $(in) > $(out)"
}

// libcamera-base.so
cc_library_shared {
    name: "libcamera-base",
    rtti: true,
    proprietary: true,
    srcs: [
        "src/libcamera/base/*.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLIBCAMERA_BASE_PRIVATE",
        "-DHAVE_LOCALE_T=1",
        "-DHAVE_FILE_SEALS=1",
        "-DHAVE_MEMFD_CREATE=1",
    ],

    static_libs: [
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libutils",
        "liblog",
    ],
    include_dirs: [
        "system/core/libcutils/include",
    ],
    local_include_dirs: [
        "include",
        "prebuilt-android/include",
    ],
    export_include_dirs: [
        "include",
        "prebuilt-android/include",
    ],
}

// libcamera.so
cc_library_shared {
    name: "libcamera",
    rtti: true,
    proprietary: true,
    srcs: [
        "src/libcamera/*.cpp",
        "src/libcamera/sensor/*.cpp",
        "src/libcamera/pipeline/nxp/neo/*.cpp",
        "src/libcamera/pipeline/imx8-isi/*.cpp",
        "src/libcamera/pipeline/simple/*.cpp",
        "src/libcamera/software_isp/*.cpp",
        "prebuilt-android/src/libcamera/control_ids.cpp",
        "prebuilt-android/src/libcamera/property_ids.cpp",
        "prebuilt-android/src/libcamera/proxy/nxpneo_ipa_proxy.cpp",
        "prebuilt-android/src/libcamera/proxy/soft_ipa_proxy.cpp",
        ":libcamera_gen_version_cpp",
        ":libcamera_gen_ipa_pub_key",
    ],

    exclude_srcs: [
        "src/libcamera/device_enumerator_udev.cpp",
        "src/libcamera/software_isp/debayer_egl.cpp",
        "src/libcamera/egl.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLIBCAMERA_BASE_PRIVATE",
        "-DLIBCAMERA_DATA_DIR=\"/data/vendor/libcamera\"",
        "-DLIBCAMERA_SYSCONF_DIR=\"/vendor/etc/configs/libcamera\"",
        "-DIPA_PROXY_DIR=\"/vendor/bin\"",
        "-DIPA_CONFIG_DIR=\"/vendor/etc/configs/libcamera\"",
        "-DIPA_MODULE_DIR=\"/vendor/lib64/ipa\"",
        "-DNXP_NEO_PIPELINE_DATA_DIR=\"/vendor/etc/configs/libcamera/nxp/neo\"",
        "-DHAVE_IPA_PUBKEY=1",
        "-DHAVE_MEMFD_CREATE=1",
        "-DHAVE_FILE_SEALS=1",
        "-DHAVE_CRYPTO=1",
    ],

    static_libs: [
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libutils",
        "liblog",
        "libdl",
        "libcamera-base",
        "libyaml",
        "libcrypto",
    ],
    include_dirs: [
        "system/core/libcutils/include",
        "external/libyaml/include",
    ],
    local_include_dirs: [
        "include",
        "prebuilt-android/include",
        "src/libcamera/pipeline/nxp/neo",
    ],
}

