/*
 * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
 */

module ipa.nxpneo;

import "include/libcamera/ipa/core.mojom";

/*
 * The IPAColorSpace struct and associated enums are mirrored with the
 * libcamera ColorSpace class definition.
 */
enum IPAPrimaries {
	IPAPrimariesRaw,
	IPAPrimariesSmpte170m,
	IPAPrimariesRec709,
	IPAPrimariesRec2020,
};

enum IPATransferFunction {
	IPATransferFunctionLinear,
	IPATransferFunctionSrgb,
	IPATransferFunctionRec709,
};

enum IPAYcbcrEncoding {
	IPAYcbcrEncodingNone,
	IPAYcbcrEncodingRec601,
	IPAYcbcrEncodingRec709,
	IPAYcbcrEncodingRec2020,
};

enum IPARange {
	IPARangeFull,
	IPARangeLimited,
};

struct IPAColorSpace {
	IPAPrimaries primaries;
	IPATransferFunction transferFunction;
	IPAYcbcrEncoding ycbcrEncoding;
	IPARange range;
};

struct InitParams {
	uint32 hwRevision;
	uint32 apiVersion;
	string sensorEntity;
	libcamera.IPACameraSensorInfo sensorInfo;
	libcamera.ControlInfoMap sensorControls;
	libcamera.ControlList sensorControlList;
};

struct IPAConfigInfo {
	libcamera.IPACameraSensorInfo sensorInfo;
	libcamera.ControlInfoMap sensorControls;
	libcamera.ControlList sensorControlList;
	IPAModeType mode;
	IPAColorSpace colorSpace;
	/* \todo remove when available from IPACameraSensorInfo */
	uint32 bitsPerPixelAuxiliary;
};

struct DelayedControlsParams {
	uint32 delay;
	bool priorityWrite;
};

struct SensorConfig {
	map<int32, DelayedControlsParams> delayedControlsParams;
	uint32 embeddedTopLines;
	bool rgbIr;
};

/* Stream type of the camera */
enum IPAStreamType {
	IPAStreamTypeFrame,
	IPAStreamTypeIr,
};

/*
 * Those enums are mirrored in neo pipeline handler definitions in order to keep
 * both interfaces self-contained though keeping trivial enums conversion.
 */

/* Buffer types used as key in buffersId maps */
enum IPABufferType {
	IPABufferTypeImage0,
	IPABufferTypeImage1,
	IPABufferTypeEData,
	IPABufferTypeParams,
	IPABufferTypeStats,
	IPABufferTypeFrame,
	IPABufferTypeIr,
};

enum IPAContextType {
	IPAContextTypeRgb,
	IPAContextTypeIr,
};

enum IPAModeType {
	IPAModeTypeStandard,
	IPAModeTypeHdrMerge,
	IPAModeTypeRgbIr,
	IPAModeTypeRgbIrDual,
};

interface IPANxpNeoInterface {
	init(libcamera.IPASettings settings, InitParams params)
		=> (int32 ret,
		    libcamera.ControlInfoMap ipaControls,
		    SensorConfig sensorConfig);
	start() => (int32 ret);
	stop();

	configure(IPAConfigInfo configInfo,
		  map<uint32, libcamera.IPAStream> streamConfig)
		=> (int32 ret, libcamera.ControlInfoMap ipaControls);

	mapBuffers(array<libcamera.IPABuffer> buffers);
	unmapBuffers(array<uint32> ids);

	[async] queueRequest(uint32 frame, libcamera.ControlList reqControls);
	[async] computeParams(uint32 frame, IPAContextType context, map<uint32, uint32> bufferIds);
	[async] processStats(uint32 frame, IPAContextType context, map<uint32, uint32> bufferIds,
			     libcamera.ControlList sensorControls);
};

interface IPANxpNeoEventInterface {
	paramsComputed(uint32 frame, IPAContextType context, uint32 bytesused);
	setSensorControls(uint32 frame, IPAContextType context, libcamera.ControlList sensorControls);
	metadataReady(uint32 frame, IPAContextType context, libcamera.ControlList metadata);
};
